<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<base target="_top">
<title>ひっ算</title>
<style>
:root{
  --page:#E8F2EE; --paper:#FBFDFC; --grid:#CFE5DF; --grid2:#9DBFB6;
  --ink:#22304A; --ink-soft:#5F6F88; --pencil:#2A2F45;
  --ones:#2468E0; --ones-bg:#DCE8FF;
  --tens:#E8821A; --tens-bg:#FFE9CF;
  --huns:#1F9D5A; --huns-bg:#D6F2E3;
  --carry:#D6336C; --carry-bg:#FFE0EC;
  --ok:#1F8A52; --ok-bg:#DDF5E8; --hint:#9A4A00; --hint-bg:#FFF1CC;
  --mark:#FFE680;
  --cell:clamp(4rem,min(14.5vh,14vw),9rem);
  --sign:calc(var(--cell)*.55);
  --font:"UD Digi Kyokasho N-R","UD デジタル 教科書体 N-R","BIZ UDPGothic","Hiragino Maru Gothic ProN","Yu Gothic UI","Meiryo",system-ui,sans-serif;
}
@media (orientation:portrait){:root{--cell:clamp(4rem,min(9.2vh,16vw),9rem)}}
*{box-sizing:border-box}
html{font-size:16px;-webkit-text-size-adjust:100%}
html.big{font-size:19px}
body{
  margin:0;background:var(--page);color:var(--ink);font-family:var(--font);line-height:1.5;
  overscroll-behavior:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;
  -webkit-tap-highlight-color:transparent;touch-action:manipulation;
}
button,select{font-family:inherit;color:inherit;cursor:pointer;touch-action:manipulation}
button:focus-visible{outline:4px solid var(--ones);outline-offset:2px}

/* ---------- 全体レイアウト（10.1〜10.5インチ・横向きを基本に、縦向きにも対応） ---------- */
.app{
  height:100vh;height:100dvh;padding:.5rem;display:grid;gap:.5rem;
  grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);
  grid-template-rows:minmax(0,1fr);
  grid-template-areas:"paper guide";
}
@media (orientation:portrait){
  .app{
    height:auto;min-height:100vh;min-height:100dvh;
    grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto;
    grid-template-areas:"paper" "guide";
  }
}
.a-paper{grid-area:paper;min-height:0}.a-guide{grid-area:guide;min-height:0}
.head-tools{display:flex;flex-wrap:wrap;gap:.3rem;align-items:center}
.chip{border:2.5px solid var(--ink);background:#fff;border-radius:999px;padding:.15rem .6rem;font-size:.95rem;font-weight:700;min-height:2.3rem}
.chip[aria-pressed="true"]{background:var(--ink);color:#fff}
.chip.tool{border-color:var(--ink-soft);color:var(--ink-soft);font-size:.9rem}

/* ---------- 筆算用紙（方眼ノート） ---------- */
.card{
  position:relative;height:100%;
  background-color:var(--paper);
  background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);
  background-size:1.6rem 1.6rem;
  border:3px solid var(--ink);border-radius:1.2rem;padding:.7rem .5rem;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5rem;
}
@media (orientation:portrait){.card{height:auto}}
#ink{position:absolute;left:0;top:0;width:100%;height:100%;z-index:5;touch-action:none;border-radius:1.1rem;cursor:crosshair}
#ink.off{pointer-events:none}
.board{display:grid;justify-content:center;column-gap:.3rem;
  grid-template-rows:auto calc(var(--cell)*.85) var(--cell) var(--cell) .55rem var(--cell)}
.cell{position:relative;display:flex;align-items:center;justify-content:center;
  font-size:calc(var(--cell)*.74);font-weight:700;line-height:1;border-radius:.8rem;
  transition:background .25s,opacity .25s,box-shadow .25s}
.p-o{color:var(--ones)}.p-t{color:var(--tens)}.p-h{color:var(--huns)}
.sign,.mult{color:var(--ink)}
.sign{font-size:calc(var(--cell)*.6)}
.rule{align-self:center;height:.38rem;background:var(--ink);border-radius:.2rem}
.dim{opacity:.3}
.ring.p-o{background:var(--ones-bg);box-shadow:0 0 0 .22rem var(--ones)}
.ring.p-t{background:var(--tens-bg);box-shadow:0 0 0 .22rem var(--tens)}
.mark{background:var(--mark);box-shadow:0 0 0 .22rem #E0B400}
.hdr{font-size:.85rem;font-weight:700;border-radius:.7rem;padding:.15rem .1rem;margin-bottom:.3rem;white-space:nowrap;position:relative;opacity:.5}
.hdr.p-o{background:var(--ones-bg)}.hdr.p-t{background:var(--tens-bg)}.hdr.p-h{background:var(--huns-bg)}
.hdr.on{opacity:1;color:#fff}.hdr.on.p-o{background:var(--ones)}.hdr.on.p-t{background:var(--tens)}.hdr.on.p-h{background:var(--huns)}
.hdr .arr{position:absolute;right:-.7rem;top:50%;transform:translateY(-50%);font-size:1rem;color:var(--ink-soft);opacity:.45}
.hdr.on .arr{color:var(--tens);opacity:1}

/* 書く場所（マス目） */
.slot{border:.2rem dashed var(--grid2);background:rgba(255,255,255,.55)}
.slot .ghost{display:none;font-size:calc(var(--cell)*.26);font-weight:700;opacity:.8;position:absolute;bottom:.15rem}
.slot.target .ghost{display:block}
.slot.target{animation:blink 1.4s ease-in-out infinite;background:rgba(255,255,255,.9)}
.slot.target.p-o{border-color:var(--ones);color:var(--ones)}
.slot.target.p-t{border-color:var(--tens);color:var(--tens)}
.slot.target.p-h{border-color:var(--huns);color:var(--huns)}
.slot.carry-slot{border-color:#E6B5C9;border-radius:.6rem}
.slot.carry-slot.target{border-color:var(--carry);color:var(--carry);background:var(--carry-bg)}
.slot.carry-slot .ghost{bottom:auto;font-size:calc(var(--cell)*.2)}
.slot.touching{box-shadow:0 0 0 .25rem #7BD39F;background:var(--ok-bg)}
.slot.used .tick{position:absolute;right:.1rem;top:-.1rem;font-size:calc(var(--cell)*.2);color:var(--ok);background:#fff;border-radius:.4rem;padding:0 .2rem}
.final{animation:glow 1.6s ease-in-out infinite alternate}
@keyframes blink{50%{box-shadow:0 0 0 .3rem rgba(255,230,128,.9)}}
@keyframes glow{to{box-shadow:0 0 0 .25rem #FFD54A;background:#FFF6CC}}

/* 計算メモ */
.memo{display:flex;flex-direction:column;gap:.35rem;align-items:center;z-index:1}
.memo-row{display:flex;align-items:center;gap:.5rem}
.memo-row .eq{font-size:calc(var(--cell)*.5);font-weight:700;white-space:nowrap}
.memo-box{position:relative;width:calc(var(--cell)*2.4);height:calc(var(--cell)*1.1);
  border:.2rem dashed var(--grid2);border-radius:.8rem;background:rgba(255,255,255,.7);display:flex;align-items:center;justify-content:center}
.memo-box .ghost{display:none;position:absolute;font-size:calc(var(--cell)*.22);font-weight:700;color:var(--ink-soft)}
.memo-box.target{border-color:var(--mark);background:#FFFBE0;border-color:#E0B400;animation:blink 1.4s ease-in-out infinite}
.memo-box.target .ghost{display:block}
.memo-box.touching{box-shadow:0 0 0 .25rem #7BD39F;background:var(--ok-bg)}
.c-o{color:var(--ones);font-weight:700}.c-t{color:var(--tens);font-weight:700}.c-h{color:var(--huns);font-weight:700}.c-c{color:var(--carry);font-weight:700}

/* ---------- 右側：今やること・反応・道具 ---------- */
.a-guide{display:flex;flex-direction:column;gap:.5rem;overflow:auto;-webkit-overflow-scrolling:touch}
.panel{background:#fff;border:3px solid var(--ink);border-radius:1.2rem;padding:.7rem .9rem}
.now .dots{display:flex;gap:.35rem;margin-bottom:.35rem}
.now .dot{width:.85rem;height:.85rem;border-radius:50%;border:2.5px solid var(--ink-soft);background:#fff}
.now .dot.done{background:var(--ok);border-color:var(--ok)}
.now .dot.cur{background:var(--mark);border-color:var(--ink);transform:scale(1.25)}
.now-main{display:flex;align-items:center;gap:.6rem;font-size:2rem;font-weight:700;line-height:1.25}
.now-main .num{flex:none;font-size:2.6rem;color:var(--ink)}
.now-say{font-size:1.45rem;font-weight:700;margin:.25rem 0 0}
.now-sub{font-size:1.05rem;color:var(--ink-soft);margin:.1rem 0 0}
.react{min-height:4.6rem;display:flex;flex-direction:column;justify-content:center;gap:.4rem;font-size:1.2rem;font-weight:700}
.react.ok{background:var(--ok-bg);border-color:var(--ok);color:var(--ok)}
.react.hint{background:var(--hint-bg);border-color:#E0A33A;color:var(--hint);animation:shake .4s}
.react.idle{color:var(--ink-soft);font-weight:400}
@keyframes shake{20%{transform:translateX(-.4rem)}50%{transform:translateX(.4rem)}80%{transform:translateX(-.2rem)}}
.detail{font-size:1.05rem;border-color:var(--ones);background:#F4F8FF;max-height:14rem;overflow:auto}
.detail h3{margin:0 0 .3rem;font-size:1.1rem;color:var(--ones)}
.detail p{margin:.25rem 0}
.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:.45rem}
@media (orientation:portrait){.tools{grid-template-columns:repeat(6,1fr)}.tbtn{font-size:.8rem}.tbtn .ic{font-size:1.2rem}}
.tbtn{font-size:1.1rem;font-weight:700;min-height:3.6rem;border-radius:1rem;background:#fff;border:3px solid var(--ink);box-shadow:0 .22rem 0 var(--ink);padding:.2rem .3rem;line-height:1.2}
.tbtn:active{transform:translateY(.18rem);box-shadow:0 .04rem 0 var(--ink)}
.tbtn[aria-pressed="true"]{background:var(--ink);color:#fff}
.tbtn .ic{display:block;font-size:1.4rem}
.btn{font-size:1.2rem;font-weight:700;padding:.6rem 1rem;border-radius:1rem;background:var(--ones);color:#fff;border:3px solid var(--ink);box-shadow:0 .22rem 0 var(--ink)}
.btn.small{font-size:.95rem;padding:.35rem .8rem;background:#fff;color:var(--ink);align-self:flex-start}
.praise{font-size:1.15rem;font-weight:400;margin:.3rem 0 .5rem}

/* ここやで */
.here{position:fixed;z-index:60;pointer-events:none;display:flex;flex-direction:column;align-items:center;animation:hop .7s ease-in-out infinite}
.here .bub{background:var(--carry);color:#fff;font-weight:700;font-size:1.4rem;padding:.25rem .9rem;border-radius:999px;border:3px solid #fff;box-shadow:0 .2rem .6rem rgba(0,0,0,.25);white-space:nowrap}
.here .tip{font-size:1.8rem;line-height:1;color:var(--carry);text-shadow:0 0 .2rem #fff}
@keyframes hop{50%{margin-top:-.5rem}}
.here-target{outline:.35rem solid var(--carry);outline-offset:.1rem}

/* きろく・かいせつ */
.drawer{position:fixed;inset:0;z-index:70;background:rgba(34,48,74,.45);display:flex;justify-content:center;align-items:flex-start;padding:1rem;overflow:auto}
.drawer[hidden]{display:none}
.drawer .sheet{background:#fff;border:3px solid var(--ink);border-radius:1.2rem;max-width:44rem;width:100%;padding:1rem 1.2rem}
.sheet h2{font-size:1.2rem;margin:.8rem 0 .4rem}
.sheet h2:first-child{margin-top:0}
.sheet p,.sheet li{margin:.25rem 0}
.sheet ul{margin:0;padding-left:1.2rem}
.cats{display:flex;flex-wrap:wrap;gap:.4rem}
.cat{font-size:.95rem;padding:.2rem .7rem;border-radius:999px;background:#EEF2F6;color:var(--ink-soft);font-weight:700}
.cat.has{background:var(--hint-bg);color:var(--hint)}
.mlog{font-size:.95rem;color:var(--ink-soft)}
.privacy{font-size:.85rem;color:var(--ink-soft)}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<noscript>JavaScriptを有効にしてください。</noscript>
<div class="app">

  <section class="a-paper">
    <div class="card" id="paper" aria-label="ひっ算ようし。ゆびやペンで 数字を書こう">
      <div id="board"></div>
      <div class="memo" id="memo"></div>
      <canvas id="ink"></canvas>
    </div>
  </section>

  <section class="a-guide">
    <div class="head-tools" id="chips"></div>
    <div class="panel now" id="now"></div>
    <div class="panel react idle" id="react" aria-live="polite"></div>
    <div class="panel detail" id="detail" hidden></div>
    <div class="tools">
      <button class="tbtn" data-act="pen" id="bPen" aria-pressed="true"><span class="ic">✏️</span>えんぴつ</button>
      <button class="tbtn" data-act="eraser" id="bEraser" aria-pressed="false"><span class="ic">🧽</span>けしごむ</button>
      <button class="tbtn" data-act="hint"><span class="ic">💡</span>ヒント</button>
      <button class="tbtn" data-act="undo"><span class="ic">↩️</span>ひとつ もどる</button>
      <button class="tbtn" data-act="clearStep"><span class="ic">🗑️</span>ぜんぶ けす</button>
      <button class="tbtn" data-act="restart" id="bRestart"><span class="ic">🔄</span>はじめから</button>
    </div>
  </section>
</div>

<div class="drawer" id="drawer" hidden>
  <div class="sheet" id="sheet"></div>
</div>

<script>
(function(){
'use strict';

/*HW-START*/
var HW = (function(){
  var N = 40;
  function arc(cx,cy,rx,ry,a0,a1,n){
    var r=[]; n=n||20;
    for(var i=0;i<=n;i++){
      var a=(a0+(a1-a0)*i/n)*Math.PI/180;
      r.push([cx+rx*Math.cos(a), cy+ry*Math.sin(a)]);
    }
    return r;
  }
  function cat(){var r=[];for(var i=0;i<arguments.length;i++)r=r.concat(arguments[i]);return r;}

  // 数字の見本（0〜100 の枠の中。書き方のちがいを複数用意）
  var SHAPES = {
    0:[ [arc(50,50,30,45,270,630,36)], [arc(50,50,22,45,270,630,36)], [arc(50,50,38,44,300,660,36)] ],
    1:[ [[[50,5],[50,95]]], [[[30,28],[50,5],[50,95]]], [[[30,28],[50,5],[50,95]],[[28,95],[72,95]]] ],
    2:[ [cat(arc(50,32,28,27,185,395,14),[[22,93],[80,93]])],
        [cat(arc(50,32,28,27,185,395,14),[[22,93]])],
        [cat(arc(50,32,28,27,185,395,14),[[22,93]]),[[20,93],[80,93]]] ],
    3:[ [cat(arc(48,27,24,22,200,450,16),arc(48,71,28,23,270,520,18))],
        [cat([[22,8],[75,8],[45,45]],arc(48,71,28,23,270,520,18))] ],
    4:[ [[[62,5],[18,62],[85,62]],[[65,30],[65,95]]],
        [[[28,5],[22,58],[82,58]],[[66,5],[66,95]]],
        [[[62,5],[15,65],[88,65]],[[62,5],[62,95]]] ],
    5:[ [cat([[75,8],[30,8],[26,46]],arc(46,68,28,24,250,520,18))],
        [[[75,8],[30,8]],cat([[30,8],[26,46]],arc(46,68,28,24,250,520,18))] ],
    6:[ [cat([[66,5],[40,28],[28,55]],arc(50,70,26,25,170,530,22))],
        [cat([[62,5],[36,30],[24,62]],arc(50,70,26,25,180,540,22))] ],
    7:[ [[[20,8],[80,8],[40,95]]],
        [[[20,8],[80,8],[40,95]],[[32,52],[68,52]]],
        [cat([[18,14],[30,6],[80,8]],[[55,50],[38,95]])] ],
    8:[ [arc(50,27,21,21,0,360,18),arc(50,72,27,24,0,360,20)].map(function(s){return s;}),
        [cat(arc(50,28,22,21,320,90,18),arc(50,72,27,24,270,630,22))] ],
    9:[ [arc(50,30,26,24,0,360,22),[[76,30],[72,60],[55,95]]],
        [cat(arc(50,30,26,24,30,390,22),[[76,32],[74,65],[58,95]])],
        [arc(50,30,26,24,0,360,22),[[76,30],[76,95]]] ]
  };

  function dist(a,b){var dx=a.x-b.x,dy=a.y-b.y;return Math.sqrt(dx*dx+dy*dy);}
  function pathLength(pts){
    var d=0;
    for(var i=1;i<pts.length;i++) if(pts[i].id===pts[i-1].id) d+=dist(pts[i-1],pts[i]);
    return d;
  }
  function resample(src,n){
    var pts=src.map(function(p){return {x:p.x,y:p.y,id:p.id};});
    var I=pathLength(pts)/(n-1), D=0, out=[pts[0]];
    if(!(I>0)) return null;
    for(var i=1;i<pts.length;i++){
      if(pts[i].id===pts[i-1].id){
        var d=dist(pts[i-1],pts[i]);
        if(D+d>=I){
          var t=(I-D)/d;
          var q={x:pts[i-1].x+t*(pts[i].x-pts[i-1].x), y:pts[i-1].y+t*(pts[i].y-pts[i-1].y), id:pts[i].id};
          out.push(q); pts.splice(i,0,q); D=0;
        }else D+=d;
      }
    }
    while(out.length<n){var l=out[out.length-1];out.push({x:l.x,y:l.y,id:l.id});}
    return out.slice(0,n);
  }
  function normalize(pts){
    var minx=1e9,miny=1e9,maxx=-1e9,maxy=-1e9,i;
    for(i=0;i<pts.length;i++){
      minx=Math.min(minx,pts[i].x);maxx=Math.max(maxx,pts[i].x);
      miny=Math.min(miny,pts[i].y);maxy=Math.max(maxy,pts[i].y);
    }
    var s=Math.max(maxx-minx,maxy-miny); if(s<1e-6) s=1;
    var cx=0,cy=0;
    var o=pts.map(function(p){return {x:(p.x-minx)/s,y:(p.y-miny)/s,id:p.id};});
    for(i=0;i<o.length;i++){cx+=o[i].x;cy+=o[i].y;}
    cx/=o.length;cy/=o.length;
    return o.map(function(p){return {x:p.x-cx,y:p.y-cy,id:p.id};});
  }
  function flatten(strokes){
    var r=[];
    strokes.forEach(function(s,si){s.forEach(function(p){r.push({x:p.x,y:p.y,id:si});});});
    return r;
  }
  function prep(strokes){
    strokes=strokes.map(function(st){
      var o=[];st.forEach(function(p){var l=o[o.length-1];if(!l||Math.abs(p.x-l.x)+Math.abs(p.y-l.y)>=0.8)o.push(p);});
      return o;
    });
    var f=flatten(strokes);
    if(f.length<2) return null;
    var r=resample(f,N);
    return r?normalize(r):null;
  }
  function cloudDist(a,b,start){
    var n=a.length, matched=new Array(n), i, j, sum=0, k=start;
    for(i=0;i<n;i++) matched[i]=false;
    do{
      var min=1e9, idx=-1;
      for(j=0;j<n;j++){
        if(!matched[j]){var d=dist(a[k],b[j]); if(d<min){min=d;idx=j;}}
      }
      matched[idx]=true;
      var w=1-((k-start+n)%n)/n;
      sum+=w*min;
      k=(k+1)%n;
    }while(k!==start);
    return sum;
  }
  function greedy(a,b){
    var n=a.length, step=Math.floor(Math.pow(n,0.5)), m=1e9;
    for(var i=0;i<n;i+=step){
      m=Math.min(m,cloudDist(a,b,i),cloudDist(b,a,i));
    }
    return m;
  }

  function aspect(strokes){
    var minx=1e9,miny=1e9,maxx=-1e9,maxy=-1e9;
    strokes.forEach(function(s){s.forEach(function(p){
      minx=Math.min(minx,p.x);maxx=Math.max(maxx,p.x);miny=Math.min(miny,p.y);maxy=Math.max(maxy,p.y);});});
    var w=maxx-minx,h=maxy-miny; if(h<1e-6) return 3;
    return Math.min(w/h,1.5);
  }
  var AR_W=0;
  var TEMPLATES=[];
  Object.keys(SHAPES).forEach(function(d){
    SHAPES[d].forEach(function(shape){
      var base=shape.map(function(s){return s.map(function(p){return {x:p[0],y:p[1]};});});
      // 書き方のちがい（ななめ・細い・太い）も見本にする
      [[0,1],[0.22,1],[-0.22,1],[0,0.72],[0,1.3]].forEach(function(v){
        var strokes=base.map(function(s){return s.map(function(p){return {x:(p.x-50+v[0]*(p.y-50))*v[1]+50,y:p.y};});});
        var t=prep(strokes);
        if(t) TEMPLATES.push({d:parseInt(d,10),pts:t,ar:aspect(strokes)});
      });
    });
  });

  // strokes: [[{x,y}...],...] → 数字ごとの距離（小さいほど似ている）
  function recognize(strokes){
    var p=prep(strokes);
    if(!p) return null;
    var best={}, ar=aspect(strokes);
    TEMPLATES.forEach(function(t){
      var d=greedy(p,t.pts)+AR_W*Math.abs(ar-t.ar);
      if(best[t.d]===undefined||d<best[t.d]) best[t.d]=d;
    });
    var cand=Object.keys(best).map(function(k){return {d:parseInt(k,10),dist:best[k]};});
    cand.sort(function(a,b){return a.dist-b.dist;});
    return {cand:cand,top:cand[0].d,dist:cand[0].dist};
  }

  function bbox(strokes){
    var minx=1e9,miny=1e9,maxx=-1e9,maxy=-1e9;
    strokes.forEach(function(s){s.forEach(function(p){
      minx=Math.min(minx,p.x);maxx=Math.max(maxx,p.x);miny=Math.min(miny,p.y);maxy=Math.max(maxy,p.y);
    });});
    return {minx:minx,maxx:maxx,miny:miny,maxy:maxy,w:maxx-minx,h:maxy-miny,cx:(minx+maxx)/2,cy:(miny+maxy)/2};
  }
  // ストロークを「数字ひとつ分」ごとにまとめる（左から右へ）
  function group(strokes){
    var items=strokes.filter(function(s){return s.length>0;}).map(function(s){return {s:s,b:bbox([s])};});
    items.sort(function(a,b){return a.b.minx-b.b.minx;});
    var groups=[];
    items.forEach(function(it){
      var g=null;
      for(var i=groups.length-1;i>=0;i--){
        var gb=groups[i].b;
        var ov=Math.min(gb.maxx,it.b.maxx)-Math.max(gb.minx,it.b.minx);
        var minw=Math.max(Math.min(gb.w,it.b.w),1);
        var contained=(it.b.cx>=gb.minx&&it.b.cx<=gb.maxx);
        if(ov>0.25*minw||contained){g=groups[i];break;}
      }
      if(g){g.strokes.push(it.s);g.b=bbox(g.strokes);}
      else groups.push({strokes:[it.s],b:it.b});
    });
    groups.sort(function(a,b){return a.b.cx-b.b.cx;});
    return groups;
  }
  return {recognize:recognize,group:group,bbox:bbox,SHAPES:SHAPES};
})();
