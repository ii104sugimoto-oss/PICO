  if(e.pointerId!==pid)return;
  e.preventDefault();
  var evs=(e.getCoalescedEvents&&e.getCoalescedEvents())||[e];
  if(!evs.length) evs=[e];
  for(var k=0;k<evs.length;k++){
    var p=pt(evs[k]);
    if(S.tool==='erase'){eraseAt(p);continue;}
    if(!drawing)continue;
    var last=drawing.p[drawing.p.length-1];
    drawing.p.push(p);
    ctx.lineCap='round';ctx.lineWidth=lineW();ctx.strokeStyle='#2A2F45';
    ctx.beginPath();ctx.moveTo(last.x*cardW,last.y*cardH);ctx.lineTo(p.x*cardW,p.y*cardH);ctx.stroke();
  }
});
function penUp(e){
  if(e.pointerId!==pid)return;
  pid=null;
  clearTouching();
  var wasDrawing=!!drawing;
  drawing=null;
  if(S.tool==='erase'){redrawInk();return;}
  if(wasDrawing){
    var id=cur();
    var slow=!!MEMO[id]||(id==='writeTens'&&M.sT>0);
    clearTimeout(S.evalTimer);
    S.evalTimer=setTimeout(function(){evaluate(false);},slow?1000:700);
  }
}
cv.addEventListener('pointerup',penUp);
cv.addEventListener('pointercancel',penUp);
cv.addEventListener('contextmenu',function(e){e.preventDefault();});

/* ---- 「ここやで！」 ---- */
var hereEl=null,hereTarget=null,hereTimer=null;
function clearHere(){
  if(hereEl&&hereEl.parentNode) hereEl.parentNode.removeChild(hereEl);
  hereEl=null;
  if(hereTarget) hereTarget.classList.remove('here-target');
  hereTarget=null;
  clearTimeout(hereTimer);
}
function showHere(el,text){
  clearHere();
  if(!el) return;
  var r=el.getBoundingClientRect(),d=document.createElement('div'),below=r.top<90;
  d.className='here';
  d.innerHTML=below?'<span class="tip">▲</span><span class="bub">'+text+'</span>':'<span class="bub">'+text+'</span><span class="tip">▼</span>';
  document.body.appendChild(d);
  var w=d.offsetWidth,h=d.offsetHeight;
  d.style.left=Math.max(4,Math.min(window.innerWidth-w-4,r.left+r.width/2-w/2))+'px';
  d.style.top=Math.max(4,below?r.bottom+4:r.top-h-4)+'px';
  el.classList.add('here-target');
  hereEl=d;hereTarget=el;
  hereTimer=setTimeout(clearHere,4200);
}

/* =========================================================
   手書きの判定
   ========================================================= */
function relRect(el){
  var r=el.getBoundingClientRect(),c=card.getBoundingClientRect();
  return {x:r.left-c.left,y:r.top-c.top,w:r.width,h:r.height};
}
function inRect(b,rc,k){
  var ex=k*rc.w,ey=k*Math.max(rc.h,cellPx*0.8);
  return b.cx>=rc.x-ex&&b.cx<=rc.x+rc.w+ex&&b.cy>=rc.y-ey&&b.cy<=rc.y+rc.h+ey;
}
function toPx(s){return s.p.map(function(q){return {x:q.x*cardW,y:q.y*cardH};});}
function mkRead(r){
  var top=r.cand[0];
  var o={top:top.d,dist:top.dist,conf:top.dist<=TH.maxDist};
  function idx(e){for(var i=0;i<r.cand.length;i++) if(r.cand[i].d===e) return i;return 99;}
  // 書こうとしている数字（e）らしければ、少しくずれていても「合っている」とみなす
  o.accepts=function(e){
    var i=idx(e);if(i>=99)return false;
    var ratio=RELAX?1.8:TH.accept,rank=RELAX?4:TH.rank,cap=TH.maxDist*(RELAX?1.5:1.2);
    return i<=rank&&r.cand[i].dist<=top.dist*ratio&&r.cand[i].dist<=cap;
  };
  return o;
}
function clusterize(objs){
  var pxs=objs.map(toPx),groups=HW.group(pxs),out=[],dust=[];
  groups.forEach(function(g){
    var members=g.strokes.map(function(px){return objs[pxs.indexOf(px)];});
    var size=Math.max(g.b.w,g.b.h);
    if(size<cellPx*TH.dust){dust=dust.concat(members);return;}
    var r=HW.recognize(g.strokes);
    out.push({objs:members,b:g.b,read:r?mkRead(r):null});
  });
  return {cl:out,dust:dust};
}
function flat(cls){var r=[];cls.forEach(function(c){r=r.concat(c.objs);});return r;}

function memoHint(id,v){
  var x=id==='mulOnes'?M.o:M.t,y=M.b,carry=id==='mulTens'?M.pT:0,p=x*y,add=false,text;
  if(v===x+y){add=true;text='たすのではなく、かけ算だよ。'+x+'×'+y+'を考えよう。';}
  else if(id==='mulOnes'&&(v===M.t*M.b||v===M.t+M.b)) text='今は一の位からだよ。'+M.o+'を見てみよう。';
  else if(id==='mulTens'&&(v===M.p||v===M.o+M.b)) text='今は十の位だよ。'+M.t+'を見てみよう。';
  else if(carry>0&&v===p+carry) text='繰り上がりは、あとで合わせるよ。まず '+x+'×'+y+'だけ考えよう。';
  else if(v===x||v===y) text=x+'×'+y+'の答えを書くよ。'+y+'の段を声に出してみよう。';
  else if(v%y===0&&Math.abs(v-p)===y) text=y+'の段は あっているよ。でも1つずれたみたい。'+x+'つ目を数えなおそう。';
  else if(p>=10&&v===(p%10)*10+Math.floor(p/10)) text='数字の並びが逆かも。もう一度見てみよう。';
  else text=x+'×'+y+'を考えよう。'+y+'の段を思い出そう。';
  return {text:text,add:add};
}

function judgeMemo(id,objs,force){
  var tg=targets(id)[0],rect=relRect(tg.el),cr=clusterize(objs),cl=cr.cl;
  if(!cl.length) return {act:'none',dust:cr.dust};
  var inside=[],outside=[];
  cl.forEach(function(c){(inRect(c.b,rect,0.4)?inside:outside).push(c);});
  if(!inside.length){
    return {act:'place',msg:'答えは、ここに書こう！',point:tg.el,remove:flat(outside),dust:cr.dust,cat:null};
  }
  var stray=flat(outside);
  var stray=flat(outside);
  var E=String(expected(id)),i;
  var noRead=inside.filter(function(c){return !c.read;});
  if(noRead.length) return {act:'unread',remove:flat(inside),dust:cr.dust.concat(stray)};
  var digs=inside.map(function(c){return c.read;});
  var allOk=digs.length<=E.length;
  for(i=0;i<digs.length&&i<E.length;i++) if(!digs[i].accepts(parseInt(E[i],10))) allOk=false;
  if(allOk&&digs.length===E.length) return {act:'solve',dust:cr.dust.concat(stray)};
  if(allOk&&digs.length<E.length&&!force) return {act:'wait',dust:cr.dust.concat(stray)};
  var unsure=digs.some(function(d,k){return !d.conf&&!(k<E.length&&d.accepts(parseInt(E[k],10)));});
  if(unsure) return {act:'unread',remove:flat(inside),dust:cr.dust.concat(stray)};
  var v=parseInt(digs.map(function(d){return d.top;}).join(''),10);
  var h=memoHint(id,v);
  return {act:'wrong',cat:CAT_OF[id],detail:(id==='mulOnes'?M.o:M.t)+'×'+M.b+'に「'+v+'」と読んだ'+(h.add?'（たし算かも）':''),
    spec:h.text+'（「'+v+'」と読んだよ）',remove:flat(inside),dust:cr.dust.concat(stray)};
}

function boardWrong(id,c,T,missing){
  var m=M,d=c.read.top,kind=c.bad.kind,pt=(missing[0]||T[0]).el;
  switch(id){
    case 'writeOnes':
      if(kind==='multi') return {text:'答えの一の位には、1つの数字だけ書くよ。'+(m.pT>0?m.p+'の一の位を書こう。':''),point:pt};
      if(kind==='place'){
        if(d===m.pO) return {text:m.pO+'は 一の位に書こう。',point:pt};
        if(m.pT>0&&d===m.pT) return {text:m.pT+'は、あとで 小さく上に書くよ。今は 一の位だよ。',point:pt};
        return {text:'答えの一の位は、ここやで！',point:pt};
      }
      if(m.pT>0&&d===m.pT) return {text:m.pT+'は十の位の数だよ。一の位には '+m.p+'の 一の位を書こう。'};
      if(d===m.o||d===m.b) return {text:'かける前の数ではなく、'+m.o+'×'+m.b+'の答えを 見てみよう。'};
      return {text:(m.pT>0?m.p+'の 一の位を':m.o+'×'+m.b+'の答えを')+' 見てみよう。'};
    case 'writeCarry':
      if(kind==='multi') return {text:'繰り上がりは 1つの数字だよ。小さく上に書こう。',point:pt};
      if(kind==='place'){
        if(d===m.pT) return {text:'十の位の'+m.pT+'も、小さく上に書こう。',point:pt};
        return {text:'繰り上がりは、ここやで！',point:pt};
      }
      if(d===m.pO) return {text:m.pO+'は もう 一の位に書いたよ。十の位の'+m.pT+'を、小さく上に書こう。'};
      return {text:m.p+'の 十の位の数を、小さく上に書こう。'};
    case 'writeTens':
      if(kind==='multi') return {text:'ひとつの マスには 1つの数字を書くよ。',point:pt};
      if(kind==='place'){
        if(m.sT>0){
          if(d===m.sT) return {text:m.sT+'は 左のマスに書こう。',point:pt};
          if(d===m.sO) return {text:m.sO+'は 右のマスに書こう。',point:pt};
        }else if(d===m.s) return {text:m.s+'は 十の位に書こう。',point:pt};
        return {text:'答えの十の位は、ここやで！',point:pt};
      }
      if(m.pT>0&&d===m.q) return {text:'上の小さな'+m.pT+'を使おう。'+m.q+'と '+m.pT+'を合わせよう。'};
      if(m.pT>0&&d===m.pT) return {text:'それは繰り上がりの数だよ。'+m.q+'と合わせた答えを書こう。'};
      if(d===m.t||d===m.b) return {text:'かける前の数ではなく、'+m.t+'×'+m.b+(m.pT>0?'と繰り上がりを合わせた':'の')+'答えを書こう。'};
      return {text:m.pT>0?m.q+'と、上の小さな'+m.pT+'を合わせよう。':m.t+'×'+m.b+'の答えを見てみよう。'};
  }
  return {text:'もう一度 考えてみよう。'};
}

function judgeBoard(id,objs){
  var T=targets(id),cr=clusterize(objs),cl=cr.cl;
  if(!cl.length) return {act:'none',dust:cr.dust};
  if(cl.some(function(c){return !c.read;})) return {act:'unread',remove:flat(cl),dust:cr.dust};
  T.forEach(function(t){t.rect=relRect(t.el);});
  var byT={};
  cl.forEach(function(c){
    var best=null,bd=1e9;
    T.forEach(function(t){
      if(inRect(c.b,t.rect,0.5)){
        var dd=Math.hypot(c.b.cx-(t.rect.x+t.rect.w/2),c.b.cy-(t.rect.y+t.rect.h/2));
        if(dd<bd){bd=dd;best=t;}
      }
    });
    c.tgt=best;
    if(best){(byT[best.key]=byT[best.key]||[]).push(c);}
  });
  cl.forEach(function(c){
    if(!c.tgt){if(!c.read.conf)c.unr=true;else c.bad={kind:'place'};return;}
    if(byT[c.tgt.key].length>1){c.bad={kind:'multi'};return;}
    if(c.read.accepts(c.tgt.val)){c.good=true;return;}
    if(!c.read.conf){c.unr=true;return;}
    c.bad={kind:'digit'};
  });
  var unr=cl.filter(function(c){return c.unr;});
  if(unr.length) return {act:'unread',remove:flat(unr),dust:cr.dust};
  var bads=cl.filter(function(c){return c.bad;}),goods=cl.filter(function(c){return c.good;}),cov={};
  goods.forEach(function(c){cov[c.tgt.key]=true;});
  var missing=T.filter(function(t){return !cov[t.key];});
  if(!bads.length){
    if(!missing.length) return {act:'solve',dust:cr.dust};
    return {act:'partial',point:missing[0].el,dust:cr.dust,msg:'いいね！もうひとつ、ここやで！'};
  }
  var w=boardWrong(id,bads[0],T,missing);
  var r={act:'wrong',cat:CAT_OF[id],detail:'「'+bads[0].read.top+'」と読んだ',spec:w.text,point:w.point,remove:flat(bads),dust:cr.dust};
  if(!missing.length&&bads.every(function(c){return c.bad.kind==='place';})) r.act='solveNote';
  return r;
}

function okText(id){
  var m=M;
  switch(id){
    case 'mulOnes': return 'そう！'+m.o+'×'+m.b+'＝'+m.p+'！';
    case 'writeOnes': return m.pT>0?'そう！'+m.pO+'を 一の位に書けたね！':'そう！'+m.p+'を 一の位に書けたね。繰り上がりは ないよ！';
    case 'writeCarry': return '繰り上がりも書けたね！';
    case 'mulTens': return m.pT>0?'そう！'+m.t+'×'+m.b+'＝'+m.q+'。上に書いた繰り上がりの'+m.pT+'も使うよ！':'そう！'+m.t+'×'+m.b+'＝'+m.q+'！';
    case 'writeTens':
      if(m.pT>0) return m.sT>0?'そう！'+m.q+'＋'+m.pT+'＝'+m.s+'。最後の位だから そのまま書けたね！':'そう！'+m.q+'に繰り上がりの'+m.pT+'を合わせて '+m.s+'だね！';
      return 'そう！'+m.s+'を 書けたね！';
  }
  return '';
}
function solveStep(id,note){
  clearTimeout(S.evalTimer);clearTimeout(S.waitTimer);clearHere();
  var txt=okText(id)+(note?' '+note:'');
  S.idx++;
  S.detail=false;
  S.fb={kind:'ok',text:txt};
  if(cur()==='done') S.fb={kind:'ok',text:txt};
  renderAll();
}
function logMistake(cat,detail){
  if(!cat) return;
  stats[cat]=(stats[cat]||0)+1;S.mis++;
  mistakes.push({p:M.a+'×'+M.b,cat:cat,detail:detail});
}
function applyResult(id,res){
  silentRemove(res.dust);
  switch(res.act){
    case 'none': redrawInk();return;
    case 'wait':
      S.waitTimer=setTimeout(function(){evaluate(true);},2600);return;
    case 'unread':
      S.unread[id]=(S.unread[id]||0)+1;stats.unread++;
      flashRemove(res.remove);
      S.fb={kind:'hint',text:UNREAD_MSG};renderReact();return;
    case 'partial':
      S.fb={kind:'ok',text:res.msg};renderReact();showHere(res.point,'ここやで！');return;
    case 'place':
      flashRemove(res.remove);
      S.fb={kind:'hint',text:res.msg};renderReact();showHere(res.point,'ここやで！');return;
    case 'wrong':
      S.lv[id]=Math.min(3,(S.lv[id]||0)+1);
      logMistake(res.cat,res.detail);
      flashRemove(res.remove);
      if(res.point) showHere(res.point,'ここやで！');
      showHint(id,res.spec);
      return;
    case 'solve': solveStep(id,'');return;
    case 'solveNote': logMistake(CAT_OF[id],'ちがう場所にも書いた');solveStep(id,'（'+res.spec+'）');return;
  }
}
function evaluate(force){
  clearTimeout(S.evalTimer);clearTimeout(S.waitTimer);
  var id=cur();if(!WRITE[id])return;
  var objs=S.ink.filter(function(s){return s.step===S.idx&&!s.bad;});
  if(!objs.length)return;
  layoutMeasure();
  RELAX=(S.unread[id]||0)>=2;
  var res=MEMO[id]?judgeMemo(id,objs,force):judgeBoard(id,objs);
  applyResult(id,res);
}

/* =========================================================
   道具ボタン
   ========================================================= */
function undo(){
  var i=S.ink.length-1;
  while(i>=0&&S.ink[i].bad)i--;
  if(i<0)return;
  var s=S.ink.splice(i,1)[0];
  if(s.step<S.idx) S.idx=s.step;
  S.fb=null;S.detail=false;
  renderAll();
}
function clearStep(){
  S.ink=S.ink.filter(function(s){return s.step!==S.idx;});
  S.fb=null;
  redrawInk();renderReact();
}
var restartTimer=null;
function restart(){
  var b=$('#bRestart');
  if(!restartTimer){
    b.innerHTML='<span class="ic">❓</span>もういちど おすと はじめから';
    restartTimer=setTimeout(function(){restartTimer=null;b.innerHTML='<span class="ic">🔄</span>はじめから';},3000);
    return;
  }
  clearTimeout(restartTimer);restartTimer=null;
  b.innerHTML='<span class="ic">🔄</span>はじめから';
  startProblem(S.pi);
}
function teacherHTML(){
  var m=M,h='';
  h+='<h2>かけ算の意味</h2><p>'+m.a+'×'+m.b+'は「'+m.a+'を'+m.b+'回たす」（'+rep(m.a,m.b)+'）ことでも表せます。ひっ算では、'+m.a+'を「'+m.t+'0と'+m.o+'」に分け、<b>一の位から</b>順に、それぞれに'+m.b+'をかけて、答えを合わせます。</p>';
  h+='<h2>この問題の解き方（先生用）</h2><ol>';
  h+='<li>一の位：'+m.o+'×'+m.b+'＝'+m.p+'</li>';
  if(m.pT>0) h+='<li>'+m.p+'の一の位の'+m.pO+'を答えの一の位に、十の位の'+m.pT+'を十の位の上に小さく書く（繰り上がり）</li>';
  else h+='<li>'+m.p+'を答えの一の位に書く（繰り上がりなし）</li>';
  h+='<li>十の位：'+m.t+'×'+m.b+'＝'+m.q+'</li>';
  h+='<li>'+(m.pT>0?'繰り上がりの'+m.pT+'を合わせる：'+m.q+'＋'+m.pT+'＝'+m.s:'そのまま'+m.s)+'を答えの十の位に書く'+(m.sT>0?'（最後の位なので'+m.s+'をそのまま左に書く）':'')+'</li>';
  h+='<li>答え：'+m.ans+'</li></ol>';
  h+='<h2>手書き数字の読み取りについて</h2><p>書いた線をこの端末の中だけで読み取っています（点の並びを、0〜9の見本と比べる方法。外部サービスは使いません）。書いた場所が、マス目のどこにあたるかも見ています。確かでないときは、まちがいと決めつけず「うまく読めなかったよ」と案内し、書き直してもらいます。同じ場所で2回続けて読めないと、読み取りをさらに甘くして、「先生が OK にする」ボタンも出します。</p>';
  h+='<h2>つまずきメモ（この画面を開いている間だけ）</h2><div class="cats">';
  CATS.forEach(function(c){h+='<span class="cat'+(stats[c]>0?' has':'')+'">'+c+(stats[c]>0?' ×'+stats[c]:'')+'</span>';});
  h+='<span class="cat'+(stats.unread>0?' has':'')+'">読めなかった'+(stats.unread>0?' ×'+stats.unread:'')+'</span></div><ul class="mlog">';
  var last=mistakes.slice(-6).reverse();
  last.forEach(function(x){h+='<li>'+x.p+'：'+x.cat+'（'+x.detail+'）</li>';});
  if(!last.length) h+='<li>まだ まちがいは ありません。</li>';
  h+='</ul><p class="privacy">名前などは保存しません。記録は画面を閉じると消えます。</p>';
  h+='<p><button class="btn" data-act="closeDrawer">とじる</button></p>';
  return h;
}
function startProblem(pi){
  var pr=problems[pi];
  M=makeModel(pr.a,pr.b);
  S={pi:pi,idx:0,ink:[],fb:null,lv:{},wrong:{},unread:{},tool:'pen',mis:0,detail:false,evalTimer:null,waitTimer:null};
  renderAll();
}

/* =========================================================
   イベント
   ========================================================= */
document.addEventListener('click',function(e){
  var t=e.target.closest?e.target.closest('[data-act]'):null;
  if(!t){
    if(e.target===$('#drawer')) $('#drawer').hidden=true;
    return;
  }
  var act=t.getAttribute('data-act');
  if(act==='pen'){S.tool='pen';renderTools();}
  else if(act==='eraser'){S.tool='erase';renderTools();}
  else if(act==='hint') giveHint();
  else if(act==='undo') undo();
  else if(act==='clearStep') clearStep();
  else if(act==='restart') restart();
  else if(act==='problem') startProblem(parseInt(t.getAttribute('data-i'),10));
  else if(act==='nextProblem') startProblem((S.pi+1)%problems.length);
  else if(act==='teacherOk') solveStep(cur(),'（先生が OK にしました）');
  else if(act==='closeDetail'){S.detail=false;renderDetail();}
  else if(act==='drawer'){$('#sheet').innerHTML=teacherHTML();$('#drawer').hidden=false;}
  else if(act==='closeDrawer') $('#drawer').hidden=true;
  else if(act==='big'){document.documentElement.classList.toggle('big');renderAll();}
});
['gesturestart','gesturechange','gestureend'].forEach(function(ev){
  document.addEventListener(ev,function(e){e.preventDefault();});
});
var rzTimer=null;
window.addEventListener('resize',function(){clearTimeout(rzTimer);rzTimer=setTimeout(function(){if(S)renderAll();},150);});

/* =========================================================
   起動
   ========================================================= */
startProblem(0);
if(window.google&&google.script&&google.script.run){
  google.script.run
    .withSuccessHandler(function(list){
      if(!Array.isArray(list))return;
      var ok=list.filter(validProblem);
