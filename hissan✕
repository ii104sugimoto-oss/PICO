  S.ink=S.ink.filter(function(o){return objs.indexOf(o)<0;});
  redrawInk();
}

var drawing=null,pid=null;
function pt(e){var r=cv.getBoundingClientRect();return {x:(e.clientX-r.left)/(r.width||1),y:(e.clientY-r.top)/(r.height||1)};}
function segDist(p,a,b){
  var dx=b.x-a.x,dy=b.y-a.y,l=dx*dx+dy*dy,t=l?((p.x-a.x)*dx+(p.y-a.y)*dy)/l:0;
  t=Math.max(0,Math.min(1,t));
  return Math.hypot(p.x-(a.x+t*dx),p.y-(a.y+t*dy));
}
function eraseAt(p){
  var px={x:p.x*cardW,y:p.y*cardH},rad=cellPx*0.4,changed=false;
  S.ink=S.ink.filter(function(s){
    if(s.step!==S.idx||s.bad) return true;
    var pts=s.p.map(function(q){return {x:q.x*cardW,y:q.y*cardH};}),hit=false;
    if(pts.length===1) hit=Math.hypot(px.x-pts[0].x,px.y-pts[0].y)<rad;
    for(var i=1;i<pts.length&&!hit;i++) if(segDist(px,pts[i-1],pts[i])<rad) hit=true;
    if(hit)changed=true;
    return !hit;
  });
  if(changed) redrawInk();
}
function onPenDown(p){
  var id=cur();if(!WRITE[id])return;
  var T=targets(id),px={x:p.x*cardW,y:p.y*cardH},near=false,hit=null;
  T.forEach(function(t){
    if(!t.el)return;
    var rc=relRect(t.el);
    if(inRect({cx:px.x,cy:px.y},rc,0.5)) hit=t;
    if(Math.hypot(px.x-(rc.x+rc.w/2),px.y-(rc.y+rc.h/2))<cellPx*2.6) near=true;
  });
  if(hit) hit.el.classList.add('touching');
  else if(!near&&T[0]&&T[0].el) showHere(T[0].el,'ここやで！');
}
