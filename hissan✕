  clearTimeout(S.evalTimer);clearTimeout(S.waitTimer);clearHere();
  var p=pt(e);
  if(S.tool==='erase'){eraseAt(p);return;}
  drawing={p:[p],step:S.idx,bad:false};
  S.ink.push(drawing);
