function drawStroke(s){
  var pts=s.p,i;if(!pts.length)return;
  ctx.lineCap='round';ctx.lineJoin='round';ctx.lineWidth=lineW();
  ctx.strokeStyle=s.bad?'#E8821A':'#2A2F45';ctx.fillStyle=ctx.strokeStyle;
  if(pts.length===1){ctx.beginPath();ctx.arc(pts[0].x*cardW,pts[0].y*cardH,lineW()/2,0,6.2832);ctx.fill();return;}
  ctx.beginPath();ctx.moveTo(pts[0].x*cardW,pts[0].y*cardH);
  for(i=1;i<pts.length;i++) ctx.lineTo(pts[i].x*cardW,pts[i].y*cardH);
  ctx.stroke();
}
function redrawInk(){
  ctx.clearRect(0,0,cardW,cardH);
  S.ink.forEach(drawStroke);
}
function flashRemove(objs){
  if(!objs||!objs.length)return;
  objs.forEach(function(o){o.bad=true;});
  redrawInk();
  setTimeout(function(){S.ink=S.ink.filter(function(o){return !o.bad;});redrawInk();},750);
}
function silentRemove(objs){
